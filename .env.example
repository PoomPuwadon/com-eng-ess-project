# Copy to .env (gitignored). Everything is optional — the firm runs on free, keyless sources.

# Claude API key: turns the Head Trader and Head of Thai Markets into real LLM agents
# (claude-haiku-5-5 by default, ~$0.001 per tick). Without it they use their rule books.
ANTHROPIC_API_KEY=
AGENT_MODEL_TICK=claude-haiku-5-5
LLM_MONTHLY_CAP_USD=75

# Finnhub free-tier key (finnhub.io) for quotes; charts still come from Yahoo's public endpoint.
FINNHUB_API_KEY=

# Testing only: let stock orders fill at the last delayed price while the US market is closed.
SIM_ALLOW_CLOSED_FILLS=0

# Game server port (Vite proxies /api here) and starting balance for new visitors (minor units: 1,000,000 = ¤ 10,000.00)
GAME_PORT=8787
STARTING_BALANCE_MINOR=1000000

# Gemini (Google AI Studio) key: alternative LLM provider for the agents and the chart analyser.
# With both keys set, LLM_PROVIDER picks one (claude | gemini); default claude.
GEMINI_API_KEY=
LLM_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash

# football-data.org free-tier key (fixtures, results, crests for the Sports Analytics Arena). Server side only.
FOOTBALL_DATA_API_KEY=

# Password for the Alt+F2 executive console (CEO / Admin). Defaults to admin123 when empty: change it.
ADMIN_PASSWORD=
