# Copy to .env (gitignored). Everything is optional — the firm runs on free, keyless sources.

# Claude API key: Claude-routed agents (Head Trader, Risk Officer, Head of Thai Markets) become real LLM
# agents (claude-haiku-5-5 by default, ~$0.001-0.002 per call). Without any key every agent uses its rule book.
ANTHROPIC_API_KEY=
AGENT_MODEL_TICK=claude-haiku-5-5
LLM_MONTHLY_CAP_USD=75

# Finnhub free-tier key (finnhub.io) for quotes; charts still come from Yahoo's public endpoint.
FINNHUB_API_KEY=

# Testing only: let stock orders fill at the last delayed price while the US market is closed.
SIM_ALLOW_CLOSED_FILLS=0

# Game server port (Vite proxies /api here) and starting balance for new visitors (minor units: 1,000,000 = ¤ 10,000.00)
GAME_PORT=8787
STARTING_BALANCE_MINOR=1000000

# Gemini (Google AI Studio, free tier) key. With both keys set, Claude and Gemini run side by side:
# each agent has its own provider (Desk A Head Trader = Claude, Desk B Co-Head Trader = Gemini, ...).
# AGENT_PROVIDERS overrides per agent, e.g. head_trader=gemini,quant=claude. A provider without a key
# hands its agents to the other one. LLM_PROVIDER = default for jobs without an agent (claude | gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
AGENT_PROVIDERS=
LLM_PROVIDER=

# football-data.org free-tier key (fixtures, results, crests for the Sports Analytics Arena). Server side only.
FOOTBALL_DATA_API_KEY=

# Password for the Alt+F2 executive console (CEO / Admin). Defaults to admin123 when empty: change it.
ADMIN_PASSWORD=

# Supabase Postgres connection (session-pooler URI from Project Settings > Database). With it set, Supabase is the
# database of record; without it the firm uses a local SQLite file. Never commit the real value.
DATABASE_URL=

# OT-01 off-hours research (market + news research while the US market is closed). One cycle every N minutes,
# capped by its own monthly sub-budget inside LLM_MONTHLY_CAP_USD. Free Finnhub news is used when FINNHUB_API_KEY is set.
RESEARCH_EVERY_MIN=150
RESEARCH_BUDGET_USD=2
